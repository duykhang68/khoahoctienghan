---
import TechBlog from '../layouts/TechBlog.astro';
import TechCover from '../components/TechCover.astro';
import {topics} from '../lib/knowledge-topics';
import '../styles/techblog-index.css';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<TechBlog title="Tri thức Hàn Quốc" description="Khám phá Hàn Quốc qua ngôn ngữ, lịch sử, văn hóa, ẩm thực và đời sống bằng tiếng Việt." indexPage={true} knowledgeHome={true}>
 <div class="engineering-index knowledge-editorial-home">
  <section class="index-archive" aria-labelledby="feed-heading">
   <h1 id="feed-heading" class="sr-only">Tri thức Hàn Quốc</h1>
   <div class="index-grid feed-list" id="tech-post-list" data-layout="grid">
    {topics.map((topic,i)=><article class="index-card feed-post" data-knowledge-topic hidden={i>=6}>
     <a class="index-card-visual" href={base+'/'+topic.id+'/'} tabindex="-1" aria-hidden="true"><TechCover slug={topic.id}/></a>
     <div class="index-card-copy">
      <div class="post-meta">Tri thức Hàn Quốc</div>
      <h3><a class="knowledge-card" href={base+'/'+topic.id+'/'}>{topic.title}</a></h3>
      <p class="post-summary">{topic.desc}</p>
     </div>
    </article>)}
   </div>
   <nav id="index-pagination" class="index-pagination" aria-label="Phân trang chủ đề">
    <a href="?page=1" aria-label="Trang 1" aria-current="page">1</a>
    <a href="?page=2" aria-label="Trang 2">2</a>
    <a href="?page=2" aria-label="Trang sau">›</a>
   </nav>
   <noscript><p>Toàn bộ chủ đề có thể mở từ menu Chuyên mục.</p></noscript>
  </section>
  <section class="knowledge-reading" aria-labelledby="reading-heading">
   <h2 id="reading-heading">Bài đọc nền tảng</h2>
   <div class="knowledge-reading-links">
    <a href={base+'/ngon-ngu/hangul/'}>Hangul và cấu trúc âm tiết</a>
    <a href={base+'/lich-su/joseon/'}>Tìm hiểu về triều đại Joseon</a>
    <a href={base+'/van-hoa/chao-hoi/'}>Văn hóa chào hỏi</a>
   </div>
   <p>한글 · 한국 — Một không gian mở để tìm hiểu Hàn Quốc, từng chủ đề một.</p>
   <p>Kho tri thức được mở rộng theo từng chủ đề và ưu tiên các nguồn tham khảo chính thức.</p>
  </section>
 </div>
</TechBlog>
<style>
 .knowledge-reading{border-top:1px solid var(--line);margin-top:44px;padding-top:24px}
 .knowledge-reading h2{font-size:var(--type-h2);margin-bottom:16px}
 .knowledge-reading-links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px 24px;margin-bottom:24px}
 .knowledge-reading-links a{font-weight:600;line-height:1.4;text-decoration:underline;text-underline-offset:4px}
 .knowledge-reading p{color:var(--muted);font-size:var(--type-body);line-height:var(--type-leading);margin-bottom:8px}
 @media(max-width:640px){.knowledge-reading-links{grid-template-columns:1fr}}
</style>
<script>
 import {pageWindow,pageNumbers} from '../lib/tech-pagination.mjs';
 const cards=[...document.querySelectorAll<HTMLElement>('[data-knowledge-topic]')];
 const params=new URLSearchParams(location.search);
 const {page,pages,start,end}=pageWindow(cards.length,params.get('page'));
 cards.forEach((card,i)=>card.hidden=i<start||i>=end);
 const pager=document.getElementById('index-pagination');
 const href=(n:number)=>n===1?location.pathname:location.pathname+'?page='+n;
 if(params.has('page')&&(page===1||params.get('page')!==String(page)))history.replaceState(null,'',href(page));
 function link(n:number,text:string,label:string){const a=document.createElement('a');a.href=href(n);a.textContent=text;a.setAttribute('aria-label',label);if(n===page&&text===String(n))a.setAttribute('aria-current','page');return a;}
 if(pager){pager.replaceChildren();pager.hidden=pages<=1;if(page>1)pager.append(link(page-1,'‹','Trang trước'));for(const n of pageNumbers(page,pages))pager.append(link(n,String(n),'Trang '+n));if(page<pages)pager.append(link(page+1,'›','Trang sau'));}
</script>
