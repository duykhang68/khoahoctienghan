---
import TechBlog from '../../layouts/TechBlog.astro';
---
<TechBlog title="Engineering Foundation" description="Thống kê vận hành từ GitHub Actions">
<section class="foundation" aria-labelledby="foundation-title">
<header class="hero"><div><p class="eyebrow">P0 / ENGINEERING INTELLIGENCE</p><h1 id="foundation-title">Engineering Foundation</h1><p>Quan sát sức khỏe kỹ thuật của Tri thức Hàn Quốc.</p></div><button id="refresh" type="button">↻ Cập nhật dữ liệu</button></header>
<p class="notice" id="status" role="status">Đang tải dữ liệu công khai từ GitHub Actions…</p>
<div class="filters"><label>Workflow <select id="workflow"><option value="">Tất cả</option></select></label><label>Khoảng thời gian <select id="period"><option value="7">7 ngày</option><option value="30" selected>30 ngày</option><option value="90">90 ngày</option></select></label></div>
<div class="metrics">
{[['runs','Tổng lượt chạy','lavender'],['success','Tỷ lệ thành công','mint'],['duration','Thời gian trung bình (ước tính)','blue'],['failed','Lượt thất bại','rose']].map(([id,label,color])=><article class={color}><p>{label}</p><strong id={id}>—</strong></article>)}
</div>
<div class="charts"><article class="panel"><h2>Tỷ lệ thành công theo ngày</h2><p class="sub">Chỉ tính success / (success + failure).</p><svg id="trend" viewBox="0 0 600 230" role="img" aria-label="Biểu đồ tỷ lệ thành công theo ngày"></svg><details><summary>Dữ liệu biểu đồ</summary><ul id="trend-data"></ul></details></article><article class="panel"><h2>Trạng thái pipeline</h2><div id="distribution"></div></article></div>
<article class="panel"><h2>Hiệu suất workflow</h2><div class="tablewrap"><table><thead><tr><th>Workflow</th><th>Lượt chạy</th><th>Thành công</th><th>Thất bại</th><th>Tỷ lệ</th></tr></thead><tbody id="performance"></tbody></table></div></article>
<article class="panel"><h2>Lượt chạy gần đây</h2><div class="tablewrap"><table><thead><tr><th>Workflow</th><th>Trạng thái</th><th>Thời gian (GMT+7)</th><th>SHA</th></tr></thead><tbody id="recent"></tbody></table></div></article>
<p class="sub">Nguồn: <a href="https://github.com/duykhang68/khoahoctienghan/actions">GitHub Actions</a>. Mẫu tối đa 100 lượt chạy mới nhất; không đại diện toàn bộ lịch sử. Không dùng token, không tự polling. Thành công của workflow không đồng nghĩa production đã xác minh.</p>
</section>
</TechBlog>
<script>
type Run={id:number;name:string;status:string;conclusion:string|null;created_at:string;run_started_at:string|null;updated_at:string;head_sha:string};
const el=(id:string)=>document.getElementById(id)!;
const workflow=el('workflow') as HTMLSelectElement, period=el('period') as HTMLSelectElement, refresh=el('refresh') as HTMLButtonElement;
let runs:Run[]=[];
const state=(r:Run)=>r.status==='completed'?(r.conclusion||'unknown'):r.status;
const rate=(a:Run[])=>{const s=a.filter(r=>state(r)==='success').length,f=a.filter(r=>state(r)==='failure').length;return s+f?Math.round(s/(s+f)*1000)/10:null};
const fmt=(v:number|null)=>v===null?'—':v.toLocaleString('vi-VN')+'%';
const day=(s:string)=>new Intl.DateTimeFormat('sv-SE',{timeZone:'Asia/Ho_Chi_Minh'}).format(new Date(s));
function textCell(row:HTMLTableRowElement,value:string){row.insertCell().textContent=value;}
function render(){
 const selected=runs.filter(r=>(!workflow.value||r.name===workflow.value)&&Date.parse(r.created_at)>=Date.now()-Number(period.value)*86400000);
 const done=selected.filter(r=>r.status==='completed'&&r.run_started_at&&Date.parse(r.updated_at)>=Date.parse(r.run_started_at));
 const secs=done.length?Math.round(done.reduce((n,r)=>n+(Date.parse(r.updated_at)-Date.parse(r.run_started_at!))/1000,0)/done.length):null;
 el('runs').textContent=String(selected.length);el('success').textContent=fmt(rate(selected));el('failed').textContent=String(selected.filter(r=>state(r)==='failure').length);el('duration').textContent=secs===null?'—':Math.floor(secs/60)+'m '+secs%60+'s';
 const groups=new Map<string,Run[]>();for(const r of selected){const a=groups.get(r.name)||[];a.push(r);groups.set(r.name,a);}
 const tbody=el('performance');tbody.replaceChildren();for(const [name,a] of groups){const tr=document.createElement('tr');[name,String(a.length),String(a.filter(r=>state(r)==='success').length),String(a.filter(r=>state(r)==='failure').length),fmt(rate(a))].forEach(v=>textCell(tr,v));tbody.append(tr);}
 const colors:Record<string,string>={success:'#0d9488',failure:'#e11d48',cancelled:'#d97706',in_progress:'#2563eb',queued:'#7c3aed'};
 const dist=el('distribution');dist.replaceChildren();for(const s of [...new Set(selected.map(state))]){const n=selected.filter(r=>state(r)===s).length;const item=document.createElement('div');item.className='distribution-row';const label=document.createElement('p');label.textContent=s+' · '+n+' lượt';const bar=document.createElement('progress');bar.max=selected.length;bar.value=n;bar.setAttribute('aria-label',s);bar.style.accentColor=colors[s]||'#64748b';item.append(label,bar);dist.append(item);}
 const recent=el('recent');recent.replaceChildren();for(const r of selected.slice(0,20)){const tr=document.createElement('tr');const link=document.createElement('a');link.href='https://github.com/duykhang68/khoahoctienghan/actions/runs/'+encodeURIComponent(String(r.id));link.textContent=r.name;tr.insertCell().append(link);textCell(tr,state(r));textCell(tr,new Date(r.created_at).toLocaleString('vi-VN',{timeZone:'Asia/Ho_Chi_Minh'}));textCell(tr,r.head_sha.slice(0,7));recent.append(tr);}
 const dates=[...new Set(selected.map(r=>day(r.created_at)))].sort();const series=dates.map(d=>({d,v:rate(selected.filter(r=>day(r.created_at)===d))})).filter((x):x is {d:string;v:number}=>x.v!==null);
 const svg=el('trend');svg.replaceChildren();const list=el('trend-data');list.replaceChildren();
 function node(tag:string,attrs:Record<string,string>,value?:string){const n=document.createElementNS('http://www.w3.org/2000/svg',tag);for(const [k,v] of Object.entries(attrs))n.setAttribute(k,v);if(value)n.textContent=value;svg.append(n);}
 for(const v of [0,25,50,75,100]){const y=190-v*1.7;node('line',{x1:'48',x2:'580',y1:String(y),y2:String(y),stroke:'#dbe4ef'});node('text',{x:'42',y:String(y+4),'text-anchor':'end',fill:'#475569','font-size':'11'},v+'%');}
 const pts=series.map((s,i)=>({x:48+(series.length===1?266:i*532/(series.length-1)),y:190-s.v*1.7,...s}));
 if(pts.length){node('polygon',{points:[pts[0].x+',190',...pts.map(p=>p.x+','+p.y),pts[pts.length-1].x+',190'].join(' '),fill:'#ccfbf1'});node('polyline',{points:pts.map(p=>p.x+','+p.y).join(' '),fill:'none',stroke:'#0d9488','stroke-width':'3'});}
 for(const [i,p] of pts.entries()){node('circle',{cx:String(p.x),cy:String(p.y),r:'4',fill:'#0d9488'});if(i===0||i===pts.length-1||i%Math.ceil(pts.length/5)===0)node('text',{x:String(p.x),y:'212','text-anchor':'middle',fill:'#475569','font-size':'10'},p.d.slice(5));const li=document.createElement('li');li.textContent=p.d+': '+fmt(p.v);list.append(li);}
 if(!pts.length)node('text',{x:'310',y:'110','text-anchor':'middle',fill:'#475569'},'Chưa đủ dữ liệu');
 if(!selected.length){dist.textContent='Không có lượt chạy trong mẫu đã chọn.';for(const body of [tbody,recent]){const tr=document.createElement('tr');const td=tr.insertCell();td.colSpan=5;td.textContent='Không có dữ liệu';body.append(tr);}}
}
async function load(){refresh.disabled=true;el('status').textContent='Đang tải…';try{const res=await fetch('https://api.github.com/repos/duykhang68/khoahoctienghan/actions/runs?per_page=100',{headers:{Accept:'application/vnd.github+json'}});if(!res.ok)throw new Error('HTTP '+res.status);const data=await res.json();if(!Array.isArray(data.workflow_runs))throw new Error('Dữ liệu không hợp lệ');runs=data.workflow_runs;const old=workflow.value;workflow.replaceChildren(new Option('Tất cả',''));for(const name of [...new Set(runs.map(r=>r.name))].sort())workflow.add(new Option(name,name));workflow.value=[...workflow.options].some(o=>o.value===old)?old:'';render();el('status').textContent='Đã tải '+runs.length+' lượt gần nhất · '+new Date().toLocaleString('vi-VN',{timeZone:'Asia/Ho_Chi_Minh'})+' (GMT+7)';}catch{el('status').textContent='Không thể tải GitHub Actions (mạng hoặc giới hạn API). '+(runs.length?'Đang giữ dữ liệu lần tải trước.':'Chưa có dữ liệu.');}finally{refresh.disabled=false;}}
 workflow.addEventListener('change',()=>render());period.addEventListener('change',()=>render());refresh.addEventListener('click',load);load();
</script>
<style>
.foundation{max-width:1200px;margin:auto;padding:clamp(16px,4vw,48px);color:#17233c;background:#fff;line-height:1.5}.hero{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;background:linear-gradient(115deg,#eef2ff,#f0fdfa);border-radius:18px;padding:clamp(18px,4vw,38px)}.hero h1{font-size:clamp(28px,4vw,46px);margin:8px 0;letter-spacing:-.035em}.hero p{margin:0}.eyebrow{font-size:12px;font-weight:700;color:#4338ca;letter-spacing:.12em}.foundation button{background:#4338ca;color:white;border:0;border-radius:9px;padding:12px 18px;font:inherit;cursor:pointer}.foundation button:disabled{opacity:.6}.notice,.sub{color:#475569;font-size:14px}.filters{display:flex;flex-wrap:wrap;gap:16px;margin:20px 0}.filters label{display:grid;gap:5px;font-size:14px;font-weight:600}.filters select{max-width:100%;padding:9px;border:1px solid #cbd5e1;border-radius:8px;color:#17233c;background:#fff;font:inherit}.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,190px),1fr));gap:14px}.metrics article{padding:20px;border-radius:14px;min-width:0}.metrics p{margin:0 0 8px;font-size:14px}.metrics strong{font-size:30px;font-variant-numeric:tabular-nums}.lavender{background:#eef2ff;color:#4338ca}.mint{background:#ecfdf5;color:#047857}.blue{background:#e0f2fe;color:#075985}.rose{background:#fff1f2;color:#be123c}.charts{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);gap:16px}.panel{border:1px solid #e2e8f0;border-radius:14px;padding:20px;margin-top:18px;min-width:0}.panel h2{font-size:20px;margin:0 0 12px}.panel svg{width:100%;height:auto}.distribution-row p{font-size:14px;margin:8px 0 3px}.distribution-row progress{width:100%;height:12px}.tablewrap{overflow-x:auto}.panel table{border-collapse:collapse;width:100%;font-size:14px}.panel th,.panel td{text-align:left;padding:12px 8px;border-bottom:1px solid #e2e8f0;overflow-wrap:anywhere}.panel th{background:#f1f5f9}.foundation a{color:#4338ca}.foundation :focus-visible{outline:3px solid #2563eb;outline-offset:3px}@media(max-width:720px){.charts{grid-template-columns:1fr}.panel{padding:12px}.panel table{font-size:12px}.panel th,.panel td{padding:8px 4px}}
</style>
