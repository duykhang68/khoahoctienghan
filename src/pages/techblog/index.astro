---
import TechBlog from '../../layouts/TechBlog.astro';
import TechCover from '../../components/TechCover.astro';
import {isReferenceHeading} from '../../lib/tech-links.mjs';
import '../../styles/techblog-index.css';
import {posts,dateLabel,yearLabel,coverURL,inferCategory,categories,archiveYears} from '../../lib/techblog';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<TechBlog title="Tech Blog" indexPage={true}>
  <div class="engineering-index">
    <div class="index-intro"><p>Chia sẻ cách chúng tôi xây dựng, vận hành và cải tiến các hệ thống phần mềm đáng tin cậy — từ kiến trúc, công cụ phát triển đến kỹ thuật production.</p></div>
    <section class="index-archive" aria-labelledby="feed-heading">
      <div class="index-toolbar filter-line">
        <div class="index-feed-title"><span class="article-count" id="article-count">{posts.length}</span><h2 id="feed-heading">Bài viết mới nhất</h2></div>
        <div class="index-view-tools"><span class="sort-label">Mới nhất</span><div class="view-switch" role="group" aria-label="Kiểu hiển thị"><button type="button" data-view="grid" aria-label="Dạng lưới" aria-pressed="true"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2" y="2" width="6" height="6" rx=".5"/><rect x="12" y="2" width="6" height="6" rx=".5"/><rect x="2" y="12" width="6" height="6" rx=".5"/><rect x="12" y="12" width="6" height="6" rx=".5"/></svg></button><button type="button" data-view="list" aria-label="Dạng danh sách" aria-pressed="false"><svg width="18" height="18" viewBox="0 0 20 20" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 4h16M2 10h16M2 16h16"/></svg></button></div></div>
      </div>
      <div class="index-filters" id="search">
        <form id="tech-search-form" class="search-box index-search" method="get" action={base+'/techblog/'}>
          <label class="sr-only" for="tech-query">Tìm kiếm bài viết</label>
          <input id="tech-query" name="q" type="search" placeholder="Tìm bài viết..."/>
          <button class="aws-button search-submit" type="submit" aria-label="Tìm kiếm"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button>
        </form>
        <label class="search-scope"><span class="sr-only">Phạm vi tìm kiếm</span><select id="search-scope" name="scope" form="tech-search-form"><option value="all">Toàn văn</option><option value="title">Chỉ tiêu đề</option></select></label>
        <nav id="categories" class="index-categories" aria-label="Lọc chuyên mục"><a href={base+'/techblog/'} data-all-categories>Tất cả</a>{categories.map(c=><a data-category-filter={c.id} href={base+'/techblog/?category='+c.id}>{c.label}</a>)}</nav>
        <form class="index-year-form" method="get" action={base+'/techblog/'}><label class="sr-only" for="archive-year">Năm lưu trữ</label><select id="archive-year" name="year"><option value="">Tất cả năm</option>{archiveYears.map(y=><option value={y}>{y}</option>)}</select><button type="submit" class="index-year-submit">Lọc</button></form>
        <a id="clear-filters" href={base+'/techblog/'} hidden>Xóa bộ lọc</a>
      </div>
      <div class="index-grid feed-list" id="tech-post-list" data-layout="grid">
        {posts.map(post=>{
          const cover=coverURL(post.cover,base);
          const href=base+'/techblog/'+post.slug+'/';
          const category=inferCategory(post);
          return <article class="index-card feed-post" data-tech-post data-category={category.id} data-year={yearLabel(post.date)} data-search={JSON.stringify([{kind:'title',text:post.title},{kind:'summary',text:post.summary},...post.sections.flatMap(s=>isReferenceHeading(s.heading)?s.paragraphs.map(p=>({kind:'reference',heading:s.heading,text:p.replace(/https?:\/\/[^\s]+/gi,'')})):[{kind:'heading',heading:s.heading,text:s.heading},...s.paragraphs.map(p=>({kind:'body',heading:s.heading,text:p.replace(/https?:\/\/[^\s]+/gi,'')}))])])}>
            <a class="index-card-visual" href={href} tabindex="-1" aria-hidden="true"><TechCover cover={cover} slug={post.slug}/></a>
            <div class="index-card-copy">
              <div class="post-meta"><time datetime={post.date}>{dateLabel(post.date)}</time><a class="topic-link" href={base+'/techblog/?category='+category.id}>{category.label}</a></div>
              <h3><a href={href}>{post.title}</a></h3>
              <div class="search-evidence" hidden><div class="search-evidence-label"></div><p class="search-snippet"></p></div>
            </div>
          </article>
        })}
      </div>
      {!posts.length&&<p class="muted">Chưa có bài viết được xuất bản.</p>}
      <p id="no-results" class="muted" role="status" hidden>Không có bài viết phù hợp.</p>
      <div class="index-more"><button id="show-more" type="button" hidden>Xem thêm <span aria-hidden="true">↓</span></button></div>
    </section>
  </div>
</TechBlog>
<script>
  import {matchPost,normalizeSearch} from '../../lib/tech-search.mjs';
  const params=new URLSearchParams(location.search);
  const query=normalizeSearch(params.get('q'));
  const scope=params.get('scope')==='title'?'title':'all';
  const year=params.get('year')||'',category=params.get('category')||'';
  const active=Boolean(query||year||category);
  const input=document.querySelector<HTMLInputElement>('#tech-query');
  if(input)input.value=params.get('q')||'';
  const select=document.querySelector<HTMLSelectElement>('#archive-year');
  if(select)select.value=year;
  const cards=[...document.querySelectorAll<HTMLElement>('[data-tech-post]')];
  const scopeSelect=document.querySelector<HTMLSelectElement>('#search-scope');
  if(scopeSelect){scopeSelect.value=scope;scopeSelect.addEventListener('change',()=>{if(input?.value.trim())document.querySelector<HTMLFormElement>('#tech-search-form')?.requestSubmit();});}
  const candidates=cards.filter(card=>(!year||card.dataset.year===year)&&(!category||card.dataset.category===category));
  const labels={title:'Khớp tiêu đề',summary:'Khớp tóm tắt',heading:'Khớp đề mục',body:'Có nhắc trong nội dung',reference:'Có nhắc trong tài liệu tham khảo'} as const;
  const ranked=candidates.map(card=>({card,match:query?matchPost(JSON.parse(card.dataset.search||'[]'),query,scope):null})).filter(item=>!query||item.match);
  if(query){
    ranked.sort((a,b)=>(b.match?.score||0)-(a.match?.score||0));
    const list=document.getElementById('tech-post-list');
    // Keep ranked results ahead of nonmatches in both visual and DOM order.
    list?.prepend(...ranked.map(item=>item.card));
    for(const {card,match} of ranked){
      if(!match)continue;
      const evidence=card.querySelector<HTMLElement>('.search-evidence');
      const label=evidence?.querySelector('.search-evidence-label');
      const snippet=evidence?.querySelector('.search-snippet');
      if(!evidence||!label||!snippet)continue;
      label.textContent=labels[match.kind as keyof typeof labels]+(match.heading&&match.kind!=='heading'?' · '+match.heading:'');
      const mark=document.createElement('mark');mark.textContent=match.highlight;
      snippet.replaceChildren(document.createTextNode(match.before),mark,document.createTextNode(match.after));
      evidence.hidden=false;
    }
    const sortLabel=document.querySelector('.sort-label');
    if(sortLabel)sortLabel.textContent='Liên quan nhất';
  }
  const matching=ranked.map(item=>item.card);
  const filterLinks=[...document.querySelectorAll<HTMLElement>('[data-category-filter]')];
  const activeCategory=filterLinks.find(a=>a.dataset.categoryFilter===category);
  if(activeCategory)activeCategory.setAttribute('aria-current','true');
  else if(!category)document.querySelector('[data-all-categories]')?.setAttribute('aria-current','true');
  if(active){
    const heading=document.getElementById('feed-heading');
    if(heading)heading.textContent=query?'Kết quả tìm kiếm':category?'Chuyên mục: '+(activeCategory?.textContent?.trim()||'Không có'):'Lưu trữ '+year;
    document.getElementById('clear-filters')?.removeAttribute('hidden');
  }
  const count=document.getElementById('article-count');
  if(count)count.textContent=String(matching.length);
  if(active&&!matching.length)document.getElementById('no-results')?.removeAttribute('hidden');
  const more=document.querySelector<HTMLButtonElement>('#show-more');
  const pageSize=12;let limit=pageSize;
  function render(){const visible=new Set(matching.slice(0,limit));for(const card of cards)card.hidden=!visible.has(card);if(more)more.hidden=matching.length<=limit;}
  render();
  more?.addEventListener('click',()=>{const firstNew=matching[limit];limit+=pageSize;render();firstNew?.querySelector('h3 a')?.focus();});
  const grid=document.getElementById('tech-post-list');
  const toggles=[...document.querySelectorAll<HTMLButtonElement>('[data-view]')];
  for(const toggle of toggles)toggle.addEventListener('click',()=>{const mode=toggle.dataset.view;if(!grid||!mode)return;grid.dataset.layout=mode;for(const item of toggles)item.setAttribute('aria-pressed',String(item===toggle));});
</script>
