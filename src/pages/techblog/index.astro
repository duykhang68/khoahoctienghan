---
import TechBlog from '../../layouts/TechBlog.astro';
import TechSidebar from '../../components/TechSidebar.astro';
import {posts,dateLabel,yearLabel,readingMinutes,coverURL,inferCategory} from '../../lib/techblog';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<TechBlog title="Tech Blog">
  <div class="tech-shell">
    <div class="editorial-grid">
      <div class="post-feed">
        <div class="filter-line"><h2 id="feed-heading">Bài viết mới nhất</h2><a id="clear-filters" href={base+'/techblog/'} hidden>Xóa bộ lọc</a></div>
        {posts.length ? <div class="feed-list" id="tech-post-list">{posts.map((post,index)=>{
          const cover=coverURL(post.cover,base);
          const href=base+'/techblog/'+post.slug+'/';
          const category=inferCategory(post);
          return <article class="feed-post" data-tech-post data-category={category.id} data-year={yearLabel(post.date)} data-search={[post.title,post.summary,post.author||'',...post.sections.flatMap(s=>[s.heading,...s.paragraphs])].join(' ').toLocaleLowerCase('vi')}>
            <div class="feed-copy">
              <h3><a href={href}>{post.title}</a></h3>
              <div class="post-meta">
                {post.author&&<span class="meta-author">Bởi {post.author}</span>}
                <time datetime={post.date}>{dateLabel(post.date)}</time>
                <span class="meta-category">trong <a class="topic-link" href={base+'/techblog/?category='+category.id}>{category.label}</a></span>
                <span>{readingMinutes(post)} phút đọc</span>
                <a href={href}>Permalink</a>
                <button class="share-link" type="button" data-copy-permalink={href}>Chia sẻ</button>
                <span class="share-status" role="status" aria-live="polite"></span>
              </div>
              <div class:list={['feed-excerpt',cover&&'has-cover']}>
                {cover&&<a class="feed-cover" href={href} tabindex="-1" aria-hidden="true"><img src={cover} alt="" width="1200" height="675" loading={index===0?'eager':'lazy'} decoding="async"/></a>}
                <p>{post.summary}</p>
              </div>
              <a class="read-link" href={href}>Đọc tiếp <span aria-hidden="true">›</span></a>
            </div>
          </article>
        })}</div> : <section class="empty-state"><span class="empty-label">ENGINEERING NOTES</span><h3>Nhật ký đang được xây dựng</h3><p>Mỗi sự cố kỹ thuật đã được sửa và xác minh sẽ được xem xét để viết một bài chia sẻ kinh nghiệm. Chưa có bài hồi cứu được phê duyệt.</p><a class="read-link" href="https://github.com/duykhang68/khoahoctienghan/issues">Xem các issue kỹ thuật <span aria-hidden="true">→</span></a></section>}
        <p id="no-results" class="muted" role="status" hidden>Không có bài viết phù hợp.</p>
      </div>
      <TechSidebar/>
    </div>
  </div>
</TechBlog>
<script>
  const params=new URLSearchParams(location.search);
  const query=(params.get('q')||'').trim().toLocaleLowerCase('vi');
  const year=params.get('year')||'';
  const category=params.get('category')||'';
  const input=document.querySelector<HTMLInputElement>('#tech-query');
  if(input)input.value=params.get('q')||'';
  if(query||year||category){
    const cards=[...document.querySelectorAll<HTMLElement>('[data-tech-post]')];
    let count=0;
    for(const card of cards){
      const match=(!query||(card.dataset.search||'').includes(query))&&(!year||card.dataset.year===year)&&(!category||card.dataset.category===category);
      card.hidden=!match;
      if(match)count++;
    }
    const heading=document.getElementById('feed-heading');
    const categoryName=[...document.querySelectorAll<HTMLElement>('[data-category-filter]')].find(a=>a.dataset.categoryFilter===category)?.textContent?.trim();
    if(heading)heading.textContent=query?'Kết quả tìm kiếm':category?('Chuyên mục: '+(categoryName||'Không có')):('Lưu trữ '+year);
    const active=[...document.querySelectorAll<HTMLElement>('[data-category-filter]')].find(a=>a.dataset.categoryFilter===category);
    active?.setAttribute('aria-current','true');
    document.getElementById('clear-filters')?.removeAttribute('hidden');
    if(!count)document.getElementById('no-results')?.removeAttribute('hidden');
  }
</script>
