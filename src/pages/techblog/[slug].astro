---
import TechBlog from '../../layouts/TechBlog.astro';
import TechCover from '../../components/TechCover.astro';
import '../../styles/techblog-article.css';
import TechVisual from '../../components/TechVisual.astro';
import TechParagraph from '../../components/TechParagraph.astro';
import TechReferences from '../../components/TechReferences.astro';
import {isReferenceHeading} from '../../lib/tech-links.mjs';
import {posts,dateLabel,readingMinutes,coverURL,inferCategory,type TechPost} from '../../lib/techblog';
export function getStaticPaths(){return posts.map(post=>({params:{slug:post.slug},props:{post}}))}
const {post}=Astro.props as {post:TechPost};
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const cover=coverURL(post.cover,base);
const category=inferCategory(post);
---
<TechBlog title={post.title} description={post.summary} cover={cover} article={true}>
  <div class="research-article-shell">
    <article class="article research-article">
      <header class="article-heading research-heading">
        <h1>{post.title}</h1>
      </header>
      <figure class="research-hero" data-cover-kind={cover?'image':'decorative'}>
        {cover?<img src={cover} alt={post.coverAlt||''} width="1200" height="675" fetchpriority="high" decoding="async"/>:<div aria-hidden="true"><TechCover slug={post.slug} eager={true}/></div>}
        {cover&&post.coverCaption&&<figcaption>{post.coverCaption}</figcaption>}
      </figure>
      <div class="research-reading-grid">
        <aside class="research-meta" aria-label="Thông tin bài viết">
          <dl class="post-meta">
            <div><dt>Xuất bản</dt><dd><time datetime={post.date}>{dateLabel(post.date)}</time></dd></div>
            <div><dt>Nhóm</dt><dd><a href={base+'/techblog/'}>Engineering</a></dd></div>
            <div><dt>Chủ đề</dt><dd><a class="topic-link" href={base+'/techblog/?category='+category.id}>{category.label}</a></dd></div>
            {post.author&&<div><dt>Tác giả</dt><dd>{post.author}</dd></div>}
            <div><dt>Thời gian đọc</dt><dd>{readingMinutes(post)} phút</dd></div>
          </dl>
          <div class="research-share">
            <a href={base+'/techblog/'+post.slug+'/'}>Permalink</a>
            <button class="share-link" type="button" data-copy-permalink={base+'/techblog/'+post.slug+'/'}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V4H4v12h4"/></svg> Sao chép liên kết</button>
            <span class="share-status" role="status" aria-live="polite"></span>
          </div>
        </aside>
        <div class="article-body">
          <p class="article-lead">{post.summary}</p>
          {post.sections.map((section,i)=>isReferenceHeading(section.heading)?
            <details class="article-disclosure article-references">
              <summary><h2 id={'section-'+i}>{section.heading}</h2><span class="disclosure-count">{section.paragraphs.length}</span><svg class="disclosure-chevron" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m5 7.5 5 5 5-5"/></svg></summary>
              <div class="disclosure-content"><TechReferences paragraphs={section.paragraphs}/></div>
            </details>:
            <section aria-labelledby={'section-'+i}><h2 id={'section-'+i}>{section.heading}</h2>{section.paragraphs.map(p=><TechParagraph value={p}/>)}{section.visuals?.map(visual=><TechVisual visual={visual}/>)}</section>)}
          {post.issues.length>0&&<details class="article-disclosure article-issues">
            <summary><h2>Issue tham khảo</h2><span class="disclosure-count">{post.issues.length}</span><svg class="disclosure-chevron" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m5 7.5 5 5 5-5"/></svg></summary>
            <div class="disclosure-content"><ul>{post.issues.map(number=><li><a href={'https://github.com/duykhang68/khoahoctienghan/issues/'+number}>Issue #{number}</a></li>)}</ul></div>
          </details>}
          <div class="article-end"><a class="read-link" href={base+'/techblog/'}>← Quay lại Engineering Blog</a></div>
        </div>
      </div>
    </article>
  </div>
</TechBlog>
