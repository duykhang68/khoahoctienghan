---
import TechBlog from '../../layouts/TechBlog.astro';
import TechSidebar from '../../components/TechSidebar.astro';
import TechParagraph from '../../components/TechParagraph.astro';
import TechReferences from '../../components/TechReferences.astro';
import {isReferenceHeading} from '../../lib/tech-links.mjs';
import {posts,dateLabel,readingMinutes,coverURL,inferCategory,type TechPost} from '../../lib/techblog';
export function getStaticPaths(){return posts.map(post=>({params:{slug:post.slug},props:{post}}))}
const {post}=Astro.props as {post:TechPost};
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const cover=coverURL(post.cover,base);
const category=inferCategory(post);
---
<TechBlog title={post.title} description={post.summary} cover={cover} article={true}>
  <div class="tech-shell detail-shell">
    <div class="editorial-grid article-grid">
    <article class="article">
      <header class="article-heading">
        <h1>{post.title}</h1>
        <div class="post-meta">
          {post.author&&<span class="meta-author">Bởi {post.author}</span>}
          <time datetime={post.date}>{dateLabel(post.date)}</time>
          <span class="meta-category">trong <a class="topic-link" href={base+'/techblog/?category='+category.id}>{category.label}</a></span>
          <span>{readingMinutes(post)} phút đọc</span>
          <a href={base+'/techblog/'+post.slug+'/'}>Permalink</a>
          <button class="share-link" type="button" data-copy-permalink>Chia sẻ</button>
          <span class="share-status" role="status" aria-live="polite"></span>
        </div>
      </header>
      {cover&&<figure class="article-cover"><img src={cover} alt={post.coverAlt||''} width="1200" height="675" fetchpriority="high" decoding="async"/></figure>}
        <div class="article-body">
          <p class="article-lead">{post.summary}</p>
          {post.sections.map((section,i)=><section class:list={[isReferenceHeading(section.heading)&&'article-references']} aria-labelledby={'section-'+i}><h2 id={'section-'+i}>{section.heading}</h2>{isReferenceHeading(section.heading)?<TechReferences paragraphs={section.paragraphs}/>:section.paragraphs.map(p=><TechParagraph value={p}/>)}</section>)}
          {post.issues.length>0&&<section><h2>Issue tham khảo</h2><ul>{post.issues.map(number=><li><a href={'https://github.com/duykhang68/khoahoctienghan/issues/'+number}>Issue #{number}</a></li>)}</ul></section>}
          <div class="article-end"><a class="read-link" href={base+'/techblog/'}>← Quay lại Engineering Blog</a></div>
        </div>
    </article>
    <TechSidebar currentSlug={post.slug}/>
    </div>
  </div>
</TechBlog>

<script>
  const button=document.querySelector<HTMLButtonElement>('[data-copy-permalink]');
  const status=document.querySelector<HTMLElement>('.share-status');
  button?.addEventListener('click', async()=>{
    const url=document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href||location.href;
    try {
      await navigator.clipboard.writeText(url);
      if(status)status.textContent='Đã sao chép liên kết';
    } catch {
      if(status)status.textContent='Dùng liên kết Permalink để chia sẻ.';
    }
  });
</script>
