---
import TechBlog from '../../layouts/TechBlog.astro';
import posts from '../../data/techblog/posts.json';
export function getStaticPaths(){return posts.map((post:any)=>({params:{slug:post.slug},props:{post}}))}
const {post}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<TechBlog title={post.title} description={post.summary}><a href={base+'/techblog/'}>← Tech Blog</a><article><h1>{post.title}</h1><time datetime={post.date}>{new Intl.DateTimeFormat('vi-VN',{dateStyle:'long',timeZone:'Asia/Ho_Chi_Minh'}).format(new Date(post.date))}</time><p class="lead">{post.summary}</p>{post.sections.map((section:any)=><section><h2>{section.heading}</h2>{section.paragraphs.map((p:string)=><p>{p}</p>)}</section>)}<h2>Issue tham khảo</h2><ul>{post.issues.map((number:number)=><li><a href={'https://github.com/duykhang68/khoahoctienghan/issues/'+number}>Issue #{number}</a></li>)}</ul></article></TechBlog>
