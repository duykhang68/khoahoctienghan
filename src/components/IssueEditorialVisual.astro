---
import type {TechVisual} from '../lib/techblog';
const {visual,section}=Astro.props as {visual:TechVisual;section:number};
const items=visual.items??[];
const total=items.reduce((sum,i)=>sum+Number(i.value||0),0);
const labels=[['Viết bản thảo','Commit'],['Đề nghị thay đổi','Pull request'],['Kiểm tra chất lượng','Continuous Integration'],['Hợp nhất bản sửa','Merge'],['Xuất bản website','Continuous Deployment'],['Xác minh bản công khai','Production Verification']];
const paths=['M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M8 13h8 M8 17h5','M6 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6 M6 9v6 M6 15a3 3 0 1 0 0 6 3 3 0 0 0 0-6 M18 15a3 3 0 1 0 0 6 3 3 0 0 0 0-6 M18 15V8a4 4 0 0 0-4-4h-2 M14 2l-2 2 2 2','M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z M9 12l2 2 4-4','M6 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6 M6 9v6 M6 15a3 3 0 1 0 0 6 3 3 0 0 0 0-6 M18 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6 M18 9c0 7-12 4-12 9','M7 18H6a5 5 0 1 1 1-10 6 6 0 0 1 11 2 4 4 0 0 1 0 8h-1 M12 21V10 M8 14l4-4 4 4','M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20 M7 12l3 3 7-7'];
const cycle=[{x:170,y:48,t:'Phát hiện',c:'#DCE8FA'},{x:268,y:117,t:'Tìm hiểu',c:'#F9E2B8'},{x:230,y:224,t:'Sửa lỗi',c:'#F3D8D8'},{x:110,y:224,t:'Xác minh',c:'#D8EBD8'},{x:72,y:117,t:'Ghi nhớ',c:'#E7DDF5'}];
---
{section===0&&<figure class="issue-visual issue-metrics" data-issue-visual="summary"><div class="metric-grid"><div><span>Tổng số issue</span><strong>{total}</strong></div>{items.map((i,n)=><div><span>{i.label}</span><strong style={n===0?'color:#D97706':'color:#16A34A'}>{i.value}</strong></div>)}</div><div class="metric-track" role="img" aria-label={items.map(i=>i.label+': '+i.value).join('; ')}>{items.map((i,n)=><span style={`width:${total?Number(i.value)/total*100:0}%;background:${n===0?'#E9B44C':'#16A34A'}`}></span>)}</div><figcaption>Nguồn: GitHub Issues, ngày 14/11/2026. Không tính pull request. {visual.caption}</figcaption></figure>}
{section===1&&<figure class="issue-visual issue-card" data-issue-visual="process"><div class="figure-title">Từ bản thảo đến website</div><ol class="process-list">{labels.map(([label,detail],n)=><li><div class="process-node"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[n]}/></svg><div><strong>{label}</strong><span>{detail}</span></div></div>{n<labels.length-1&&<svg class="process-arrow" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 4v15m-5-5 5 5 5-5"/></svg>}</li>)}</ol><figcaption>{visual.caption}</figcaption></figure>}
{section===8&&<figure class="issue-visual issue-card" data-issue-visual="cycle"><div class="figure-title">Học hỏi từ sai sót</div><svg class="cycle-svg" viewBox="0 0 340 285" role="img" aria-label="Phát hiện, tìm hiểu, sửa lỗi, xác minh, ghi nhớ, rồi tiếp tục phát hiện."><circle cx="170" cy="142" r="88" stroke="#A3A3A3" stroke-dasharray="5 5" fill="none"/>{cycle.map(n=><g><rect x={n.x-45} y={n.y-20} width="90" height="40" rx="6" fill={n.c}/><text x={n.x} y={n.y+4} text-anchor="middle" font-size="12" fill="#141414" font-weight="600">{n.t}</text></g>)}<text x="170" y="138" text-anchor="middle" fill="#141414" font-size="13" font-weight="700">Continuous</text><text x="170" y="155" text-anchor="middle" fill="#141414" font-size="13" font-weight="700">Improvement</text></svg><figcaption>{visual.caption}</figcaption></figure>}
<style>
.article-body .issue-visual{margin:28px 0 36px;min-width:0;color:#141414;font-size:14px;line-height:1.5}
.issue-card{border:1px solid #e2e2e2;border-radius:14px;padding:clamp(14px,3vw,24px);background:#fff}
.figure-title{font-size:18px;font-weight:700;margin-bottom:16px;line-height:1.4}
.metric-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:14px}
.metric-grid span{display:block;color:#666;font-size:13px}.metric-grid strong{display:block;font-size:clamp(32px,6vw,44px);line-height:1.25;font-weight:700;font-variant-numeric:tabular-nums}
.metric-track{display:flex;height:28px;overflow:hidden;border-radius:6px}.metric-track span{display:block}
.article-body .process-list{display:flex;flex-direction:column;align-items:center;gap:0;padding:0;margin:0;list-style:none}
.article-body .process-list li{display:flex;flex-direction:column;align-items:center;width:min(100%,260px);padding:0;list-style:none;text-align:left}
.process-node{display:flex;align-items:center;gap:12px;width:100%;border:1px solid #dedede;border-radius:10px;padding:13px 16px;background:#fff}
.process-node svg{flex:none;color:#333}.process-node strong{display:block;font-size:14px;line-height:1.4;font-weight:700}.process-node span{display:block;color:#666;font-size:12px;line-height:1.4;margin-top:3px}
.process-arrow{margin:5px 0;color:#888}.cycle-svg{display:block;width:100%;max-width:420px;height:auto;margin:auto}
.article-body .issue-visual figcaption{color:#666;font-size:12px;line-height:1.6;text-align:left;margin-top:12px}
@media(max-width:400px){.metric-grid{gap:8px}.metric-grid span{font-size:11px}}
</style>
