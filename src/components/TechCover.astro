---
const {cover,slug='',eager=false}=Astro.props as {cover?:string;slug?:string;eager?:boolean};
const palettes=['sage','lavender','sand','blue','rose'];
const palette=palettes[Array.from(slug).reduce((n,c)=>n+c.charCodeAt(0),0)%palettes.length];
---
<span class="editorial-cover" data-palette={palette} data-cover-kind={cover?'image':'decorative'}>
  {cover?<img src={cover} alt="" width="1200" height="675" loading={eager?'eager':'lazy'} decoding="async" fetchpriority={eager?'high':'auto'}/>:<span class="compact-fallback" aria-hidden="true"></span>}
</span>
<style>
  .compact-fallback{position:absolute;inset:0;background:linear-gradient(135deg,var(--fallback-a),var(--fallback-b))}
  [data-palette=sage]{--fallback-a:#e3ecdd;--fallback-b:#b6c9b1}
  [data-palette=lavender]{--fallback-a:#eee5f5;--fallback-b:#c9b7df}
  [data-palette=sand]{--fallback-a:#f5e8d4;--fallback-b:#e4bd94}
  [data-palette=blue]{--fallback-a:#e2edf5;--fallback-b:#b4ccdf}
  [data-palette=rose]{--fallback-a:#f5e4e3;--fallback-b:#e5b8b5}
</style>
