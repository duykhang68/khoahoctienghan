---
import type {TechVisual} from '../lib/techblog';
import '../styles/techblog-visuals.css';
const {visual:v}=Astro.props as {visual:TechVisual};
const items=v.items??[];
const safeHex=(s?:string)=>/^#[0-9a-f]{6}$/i.test(s??'')?s:'#333333';
const sizes=(n:number|undefined,max:number)=>Math.max(0,Math.min(max,Number(n)||0));
const samples=['#e3ecdd','#eee5f5','#f5e8d4','#e2edf5','#f5e4e3','#b6c9b1'];
const total=items.reduce((sum,i)=>sum+Number(i.value||0),0);
const iconPaths:Record<string,string>={file:'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M8 13h8 M8 17h5',pull:'M6 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6 M6 9v6 M6 15a3 3 0 1 0 0 6 3 3 0 0 0 0-6 M18 15a3 3 0 1 0 0 6 3 3 0 0 0 0-6 M18 15V8a4 4 0 0 0-4-4h-2 M14 2l-2 2 2 2',shield:'M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z M9 12l2 2 4-4',merge:'M6 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6 M6 9v6 M6 15a3 3 0 1 0 0 6 3 3 0 0 0 0-6 M18 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6 M18 9c0 7-12 4-12 9',cloud:'M7 18H6a5 5 0 1 1 1-10 6 6 0 0 1 11 2 4 4 0 0 1 0 8h-1 M12 21V10 M8 14l4-4 4 4',check:'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20 M7 12l3 3 7-7'};
const center=v.centerLabel??['Continuous','Improvement'];
const cycleNodes=[{x:170,y:48,c:'#DCE8FA'},{x:268,y:117,c:'#F9E2B8'},{x:230,y:224,c:'#F3D8D8'},{x:110,y:224,c:'#D8EBD8'},{x:72,y:117,c:'#E7DDF5'}];
const maxBar=Math.max(1,...items.map(i=>Number(i.value)||0));
---
<figure class="tv" data-visual={v.kind} data-variant={v.variant}>
{v.title&&<div class="tv-figure-title">{v.title}</div>}
{v.kind==='swatches'&&<><div class="tv-swatches">{items.map(i=><button type="button" class="tv-swatch" data-visual-copy={safeHex(i.color)} aria-label={'Sao chép '+i.label+' '+safeHex(i.color)}><span class="tv-color" style={`background:${safeHex(i.color)}`}></span><strong>{i.label}</strong><code>{safeHex(i.color)}</code><small>{i.detail}</small></button>)}</div><span class="tv-status" role="status" aria-live="polite"></span></>}
{v.kind==='buttons'&&<><div class="tv-buttons">{items.map(i=><div><strong>{i.label}</strong><button type="button" class="tv-demo" data-demo style={`--demo-bg:${safeHex(i.color)};--demo-fg:${safeHex(i.foreground)};--demo-hover:${safeHex(i.hover)}`}>{i.value}</button><small>{i.color} · hover {i.hover}</small></div>)}<div><strong>Disabled</strong><button type="button" class="tv-demo" disabled>Không khả dụng</button></div></div><span class="tv-status" role="status" aria-live="polite"></span></>}
{v.kind==='type'&&<div class="tv-type">{items.map(i=><div><small>{i.label} · {i.size}px · {i.weight} · {i.detail}</small><div class="tv-specimen" style={`--sample-size:${sizes(i.size,80)}px; font-weight:${sizes(i.weight,900)}`}>Công nghệ</div></div>)}</div>}
{v.kind==='spacing'&&<div class="tv-spacing">{items.map(i=><div><code>{i.label}</code><span style={`width:${sizes(i.size,160)*2}px`}></span></div>)}</div>}
{v.kind==='wireframe'&&<div class="tv-wire" role="img" aria-label={v.caption}>
 {v.layout==='listing'&&<div aria-hidden="true"><div class="tv-nav">Duy Nguyen <span>Engineering Blog</span></div><div class="tv-screen"><div class="tv-title">Tech Blog</div><div class="tv-cardgrid">{samples.map((color,i)=><div><div class="tv-thumb" style={`background:${color}`}></div><small>Engineering · 2026</small><strong>{['Kiến trúc Islands','Thiết kế hệ thống','Tối ưu CI/CD','Kỹ thuật dữ liệu','Hiệu năng Web','Bảo mật ứng dụng'][i]}</strong><i></i><i></i></div>)}</div><div class="tv-pages">‹　1　2　3　›</div></div><div class="tv-nav">Duy Nguyen</div></div>}
 {v.layout==='article'&&<div aria-hidden="true"><div class="tv-nav">Duy Nguyen <span>Engineering Blog</span></div><div class="tv-screen"><small>Tech Blog / Engineering · 14/11/2026</small><div class="tv-title">Engineering Editorial<br/>Design System 1.0</div><div class="tv-hero"></div><div class="tv-reading"><div><strong>Giới thiệu</strong>{Array.from({length:5},()=> <i></i>)}<strong>Typography</strong>{Array.from({length:4},()=> <i></i>)}<div class="tv-chartmini">{[30,55,40,70,52].map(h=><span style={`height:${h}px`}></span>)}</div></div><aside><strong>Mục lục</strong><small>Giới thiệu</small><small>Typography</small><small>Màu sắc</small></aside></div></div><div class="tv-nav">Bài viết liên quan</div></div>}
 {v.layout==='responsive'&&<div class="tv-devices" aria-hidden="true">{[3,2,1].map((n,i)=><div><strong>{['Desktop','Tablet','Mobile'][i]}</strong><div class="tv-device"><div class="tv-nav"></div><div class="tv-devicegrid" style={`--cols:${n}`}>{Array.from({length:n*2},(_,j)=><div><div class="tv-thumb" style={`background:${samples[j]}`}></div><i></i><i></i></div>)}</div></div><small>{n} cột</small></div>)}</div>}
</div>}
{v.kind==='table'&&<div class="tv-tablewrap" tabindex="0" role="region" aria-label={v.caption}><table class="tv-table"><thead><tr>{v.columns?.map(c=><th scope="col">{c}</th>)}</tr></thead><tbody>{v.rows?.map(row=><tr>{row.map((cell,i)=>i===0?<th scope="row">{cell}</th>:<td>{cell}</td>)}</tr>)}</tbody></table></div>}
{v.kind==='flow'&&(v.variant==='cycle'?<div class="tv-cycle"><svg viewBox="0 0 340 285" role="img" aria-label={items.map(i=>i.label).join(' → ')+' → '+items[0]?.label}><circle cx="170" cy="142" r="88" stroke="#a3a3a3" stroke-dasharray="5 5" fill="none"/>{items.map((i,n)=><g><rect x={cycleNodes[n].x-45} y={cycleNodes[n].y-20} width="90" height="40" rx="6" fill={cycleNodes[n].c}/><text x={cycleNodes[n].x} y={cycleNodes[n].y+4} text-anchor="middle" font-size="12" fill="#141414" font-weight="600">{i.label}</text></g>)}<text x="170" y="138" text-anchor="middle" font-size="13" font-weight="700" fill="#141414">{center[0]}</text><text x="170" y="155" text-anchor="middle" font-size="13" font-weight="700" fill="#141414">{center[1]}</text></svg><ol class="tv-cycle-key">{items.map(i=><li><strong>{i.label}</strong> — {i.detail}</li>)}</ol></div>:<ol class="tv-flow">{items.map((i,n)=><li><div class="tv-flow-node"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={iconPaths[i.icon??'']??'M4 12h16 M14 6l6 6-6 6'}/></svg><div><strong>{i.label}</strong>{i.detail&&<small>{i.detail}</small>}</div></div>{n<items.length-1&&<svg class="tv-flow-arrow" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 4v15m-5-5 5 5 5-5"/></svg>}</li>)}</ol>)}
{v.kind==='bars'&&v.variant==='summary'&&<div class="tv-summary"><div class="tv-metrics"><div><small>Tổng số</small><strong>{total}</strong></div>{items.map(i=><div><small>{i.label}</small><strong style={`color:${safeHex(i.color)}`}>{i.value}</strong></div>)}</div><div class="tv-segments" role="img" aria-label={items.map(i=>i.label+': '+i.value+' '+v.unit).join('; ')}>{items.map(i=><span style={`width:${Number(i.value)/total*100}%;background:${safeHex(i.color)}`}></span>)}</div>{v.source&&<small>Nguồn: {v.source}</small>}</div>}
{v.kind==='bars'&&v.variant!=='summary'&&<div class="tv-bars">{items.map(i=><div><span>{i.label}</span><div class="tv-bartrack" aria-hidden="true"><span style={`width:${sizes(Number(i.value)/maxBar*100,100)}%`}></span></div><strong>{i.value} {v.unit}</strong></div>)}{v.source&&<small>Nguồn: {v.source}</small>}</div>}
{v.kind==='code'&&<><div class="tv-codehead"><span>{v.language??'code'}</span><button type="button" data-visual-copy={v.code??''}>Sao chép</button></div><pre><code>{v.code}</code></pre><span class="tv-status" role="status" aria-live="polite"></span></>}
<figcaption>{v.caption}</figcaption>
</figure>
<script>
for(const button of document.querySelectorAll<HTMLButtonElement>('[data-visual-copy]')){
 button.addEventListener('click',async()=>{const status=button.closest('.tv')?.querySelector('.tv-status');try{await navigator.clipboard.writeText(button.dataset.visualCopy??'');if(status)status.textContent='Đã sao chép';}catch{if(status)status.textContent='Không thể sao chép tự động; hãy chọn nội dung thủ công.';}});
}
for(const button of document.querySelectorAll<HTMLButtonElement>('[data-demo]'))button.addEventListener('click',()=>{const status=button.closest('.tv')?.querySelector('.tv-status');if(status)status.textContent='Mẫu thử: '+button.textContent?.trim()+' — không có hành động thực tế.';});
</script>
