---
import {topics} from '../lib/knowledge-topics';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<ul class="knowledge-topic-list pastel-topic-grid">
 {topics.map(topic=><li data-palette={topic.id}><a class="knowledge-card" href={base+'/'+topic.id+'/'}><span class="topic-card-art" aria-hidden="true"><span class="topic-card-mark">{topic.mark}</span><span class="topic-card-orbit"></span><span class="topic-card-spark">✦</span></span><span class="topic-card-copy"><strong>{topic.title}</strong><small>{topic.desc}</small><span class="topic-card-more">Khám phá <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg></span></span></a></li>)}
</ul>
