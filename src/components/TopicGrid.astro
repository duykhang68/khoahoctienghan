---
import {topics as catalogue} from '../lib/knowledge-topics';
import {orderedTopics} from '../lib/knowledge-navigation.mjs';
const topics=orderedTopics(catalogue);
import {getCollection} from 'astro:content';
import {buildKnowledgeFeed} from '../lib/knowledge-feed.mjs';
import metadata from '../data/studio-metadata.json';
const articles=buildKnowledgeFeed(await getCollection('docs'),metadata,topics);
const articleCountsByTopic=new Map(topics.map(topic=>[topic.id,articles.filter(article=>article.topic===topic.id).length]));
import TechCover from './TechCover.astro';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<div class="not-content index-archive" aria-label="Các chuyên mục tri thức">
 <div class="index-grid feed-list" id="tech-post-list" data-layout="grid">
 {topics.map(topic=>{
 const count=articleCountsByTopic.get(topic.id)??0;
 return <article class="index-card feed-post" data-knowledge-topic={topic.id}>
  <a class="index-card-visual topic-count-visual" href={base+'/'+topic.id+'/'} tabindex="-1" aria-hidden="true"><TechCover slug={topic.id}/><span class="topic-count-overlay" data-topic-count-overlay style={`--topic-count-digits:${String(count).length}`}><span>{count}</span></span></a>
  <div class="index-card-copy"><div class="post-meta">Tri thức Hàn Quốc</div><h3><a class="knowledge-card" href={base+'/'+topic.id+'/'} aria-description={'Tổng '+count+' bài viết'}>{topic.title}</a></h3><p class="post-summary">{topic.desc}</p></div>
 </article>})}
 </div>
 <nav id="index-pagination" class="index-pagination" aria-label="Phân trang chuyên mục" hidden></nav>
</div>
<script>
 import {pageWindow,pageNumbers} from '../lib/tech-pagination.mjs';
 const cards=[...document.querySelectorAll<HTMLElement>('[data-knowledge-topic]')];
 const params=new URLSearchParams(location.search);
 const {page,pages,start,end}=pageWindow(cards.length,params.get('page'));
 cards.forEach((card,i)=>card.hidden=i<start||i>=end);
 const pager=document.getElementById('index-pagination');
 const href=(n:number)=>n===1?location.pathname:location.pathname+'?page='+n;
 if(params.has('page')&&(page===1||params.get('page')!==String(page)))history.replaceState(null,'',href(page));
 function link(n:number,text:string,label:string){const a=document.createElement('a');a.href=href(n);a.textContent=text;a.setAttribute('aria-label',label);if(n===page&&text===String(n))a.setAttribute('aria-current','page');return a;}
 if(pager&&pages>1){if(page>1)pager.append(link(page-1,'‹','Trang trước'));for(const n of pageNumbers(page,pages))pager.append(link(n,String(n),'Trang '+n));if(page<pages)pager.append(link(page+1,'›','Trang sau'));pager.hidden=false;}
</script>

<style>
 .topic-count-visual{position:relative;isolation:isolate}
 .topic-count-overlay{position:absolute;inset:0;z-index:2;display:grid;place-items:center;overflow:hidden;pointer-events:none;container-type:size;background:transparent;color:#435b76}
 .topic-count-visual :global(.editorial-cover[data-palette="sage"])+.topic-count-overlay{color:#39583c}
 .topic-count-visual :global(.editorial-cover[data-palette="lavender"])+.topic-count-overlay{color:#61477e}
 .topic-count-visual :global(.editorial-cover[data-palette="sand"])+.topic-count-overlay{color:#79532e}
 .topic-count-visual :global(.editorial-cover[data-palette="blue"])+.topic-count-overlay{color:#355b75}
 .topic-count-visual :global(.editorial-cover[data-palette="rose"])+.topic-count-overlay{color:#834d57}
 .topic-count-overlay>span{font-family:var(--display,system-ui);font-weight:800;font-size:min(87cqh,calc(145cqw / var(--topic-count-digits)));line-height:1;letter-spacing:-.035em;font-variant-numeric:tabular-nums;text-shadow:none}
</style>
