---
const {node}=Astro.props;
const tags:Record<string,string>={doc:'div',paragraph:'p',heading:'h'+node.attrs?.level,blockquote:'blockquote',bulletList:'ul',orderedList:'ol',listItem:'li',codeBlock:'pre',hdNote:'aside',articleDetails:'details',articleSummary:'summary',articleDetailsContent:'div',articleFigure:'figure',articleCaption:'figcaption',table:'table',tableRow:'tr',tableHeader:'th',tableCell:'td'};
const marks:Record<string,string>={bold:'strong',italic:'em',underline:'u',strike:'s',code:'code',link:'a'};
const mark=node.marks?.[0];
const Mark=mark?marks[mark.type]:'span';
const Tag=tags[node.type]||'div';
const children=node.content||[];
const attrs=node.type==='orderedList'?{start:node.attrs.start}:node.type==='hdNote'?{class:'studio-note studio-note-'+node.attrs.kind}:{};
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
{node.type==='text'?(mark?<Mark {...(mark.type==='link'?{href:mark.attrs.href,rel:'noopener noreferrer'}:{})}><Astro.self node={{...node,marks:node.marks.slice(1)}}/></Mark>:node.text):node.type==='hardBreak'?<br/>:node.type==='horizontalRule'?<hr/>:node.type==='image'?<img src={base+node.attrs.src} alt={node.attrs.alt} width={node.attrs.width} height={node.attrs.height} loading="lazy" decoding="async"/>:node.type==='codeBlock'?<pre><code>{children.map((c:any)=>c.text).join('')}</code></pre>:node.type==='table'?<div class="studio-table"><table><tbody>{children.map((child:any)=><Astro.self node={child}/>)}</tbody></table></div>:<Tag {...attrs}>{children.map((child:any)=><Astro.self node={child}/>)}</Tag>}
