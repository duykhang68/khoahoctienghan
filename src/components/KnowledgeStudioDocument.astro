---
import StudioDocument from './StudioDocument.astro';
import data from '../data/studio-documents.json';
import metadata from '../data/studio-metadata.json';
import StudioMetadata from './StudioMetadata.astro';
const {id}=Astro.props as {id:string};
if(!Object.hasOwn(data,id))throw Error('Unknown studio document: '+id);
const body=(data as Record<string,unknown>)[id];
---
<div class="not-content"><StudioMetadata metadata={(metadata as Record<string,unknown>)[id]||{}} destination="knowledge" current={id}/><StudioDocument {body}/></div>
