---
import '../styles/techblog.css';
const {title,description='Nhật ký kỹ thuật của đội ngũ phát triển Tri thức Hàn Quốc.',cover,article=false,indexPage=false}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="theme-color" content="#161d26"/>
  <title>{title} | Engineering</title>
  <meta name="description" content={description}/>
  <link rel="canonical" href={canonical}/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={canonical.toString()}/>
  {cover && <meta property="og:image" content={new URL(cover,Astro.site).toString()}/>}
  <link rel="icon" href={base+'/favicon.svg'}/>
</head>
<body class:list={[indexPage&&'engineering-index-page',article&&'research-article-page']}>
  <a class="skip" href="#content">Bỏ qua điều hướng</a>
  <header class="engineering-header">
    <nav class="engineering-nav engineering-nav-minimal" aria-label="Điều hướng Engineering">
      <a class="engineering-brand" href={base+'/techblog/'} aria-current={indexPage?'page':undefined}>Engineering Blog</a>
    </nav>
  </header>
  <div class="breadcrumb-band"><nav class="blog-breadcrumb" aria-label="Đường dẫn">
    <a href={base+'/'}>Trang chủ</a><span class="crumb-divider" aria-hidden="true">›</span>
    {article?<a href={base+'/techblog/'}>Engineering Blog</a>:<span aria-current="page">Engineering Blog</span>}
    {article&&<><span class="crumb-divider" aria-hidden="true">›</span><span class="current-crumb" aria-current="page">{title}</span></>}
  </nav></div>
  {!article&&<div class="blog-masthead"><div class="masthead-inner"><h1 class="blog-name">Engineering Blog</h1></div></div>}
  <main id="content"><slot/></main>
  <footer class="engineering-footer"><div class="footer-inner">
    <section class="footer-intro"><a class="footer-brand" href={base+'/techblog/'}>Engineering Blog</a><p>Ghi lại những điều học được khi xây dựng phần mềm.</p><a class="aws-button footer-cta" href={base+'/'}>Khám phá kho tri thức</a></section>
    <section><h2>Khám phá</h2><ul><li><a href={base+'/'}>Trang chủ</a></li><li><a href={base+'/techblog/'}>Bài viết mới</a></li><li><a href={base+'/techblog/#search'}>Tìm kiếm</a></li><li><a href={base+'/techblog/#categories'}>Chuyên mục</a></li></ul></section>
    <section><h2>Tài nguyên</h2><ul><li><a href="https://github.com/duykhang68/khoahoctienghan">Mã nguồn GitHub</a></li><li><a href="https://github.com/duykhang68/khoahoctienghan/issues">Issues</a></li><li><a href="#content">Về đầu trang ↑</a></li></ul></section>
  </div><div class="footer-bottom"><div>Tri thức Hàn Quốc · Engineering</div></div></footer>
</body>
</html>

<script>
  for(const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-permalink]')){
    button.addEventListener('click',async()=>{
      const status=button.parentElement?.querySelector<HTMLElement>('.share-status');
      const path=button.dataset.copyPermalink;
      if(!path)return;
      const url=new URL(path,location.origin).href;
      try{await navigator.clipboard.writeText(url);if(status)status.textContent='Đã sao chép liên kết';}
      catch{if(status)status.textContent='Dùng liên kết Permalink để chia sẻ.';}
    });
  }
</script>
