---
import '../styles/techblog.css';
import EditorialHeader from '../components/EditorialHeader.astro';
import EditorialFooter from '../components/EditorialFooter.astro';
const {title,description='Nhật ký kỹ thuật của đội ngũ phát triển Tri thức Hàn Quốc.',cover,article=false,indexPage=false,knowledgeHome=false}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="theme-color" content="#000000"/>
  <title>{knowledgeHome?title:title+' | Engineering'}</title>
  <meta name="description" content={description}/>
  <link rel="canonical" href={canonical}/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={canonical.toString()}/>
  {cover && <meta property="og:image" content={new URL(cover,Astro.site).toString()}/>}
  <link rel="icon" href={base+'/favicon.svg'}/>
</head>
<body class:list={[indexPage&&'engineering-index-page',article&&'research-article-page']}>
  <a class="skip" href="#content">Bỏ qua điều hướng</a>
  <EditorialHeader {title} {article} {indexPage} {knowledgeHome}/>
  <main id="content"><slot/></main>
  <EditorialFooter {knowledgeHome}/>
</body>
</html>
