---
const {title,description='Nhật ký kỹ thuật của đội ngũ phát triển Tri thức Hàn Quốc.'}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | Engineering</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/></head>
<body><a class="skip" href="#content">Bỏ qua điều hướng</a><header><nav><a class="brand" href={base+'/techblog/'}><span>Engineering</span><small>TRI THỨC HÀN QUỐC</small></a><a href={base+'/'}>Kho tri thức</a><a href="https://github.com/duykhang68/khoahoctienghan/issues">Issues</a></nav></header><main id="content"><slot/></main><footer>Engineering · Chia sẻ những điều học được khi xây dựng phần mềm. <a href={base+'/'}>Trang chủ</a></footer></body></html>
<style is:global>
*{box-sizing:border-box}html{color-scheme:light;background:#fff;color:#292929;font-family:"Google Sans","Noto Sans KR",Arial,sans-serif}body{margin:0;line-height:1.65}a{color:#a32630;text-decoration:none}a:hover{text-decoration:underline}a:focus-visible{outline:3px solid #2455a0;outline-offset:4px}.skip{position:absolute;left:-10000px}.skip:focus{left:1rem;top:1rem;background:white;padding:.5rem;z-index:2}header{border-top:4px solid #a32630;border-bottom:1px solid #e6e6e6}nav{max-width:900px;margin:auto;padding:1rem 1.25rem;display:flex;gap:1.25rem;align-items:center;flex-wrap:wrap}nav .brand{margin-right:auto;display:grid;font-family:Georgia,serif;font-size:1.55rem;font-weight:700;color:#a32630;line-height:1.1}.brand small{font:600 .62rem Arial,sans-serif;letter-spacing:.12em;color:#666;margin-top:.25rem}main{max-width:760px;margin:0 auto;padding:3rem 1.25rem 5rem}h1,h2{font-family:Georgia,"Noto Serif",serif;line-height:1.25;color:#242424}h1{font-size:clamp(2.1rem,5vw,3rem);margin:0 0 .8rem}h2{font-size:1.65rem;margin:.5rem 0;overflow-wrap:anywhere}p{overflow-wrap:anywhere}article p{text-align:justify}footer{max-width:760px;margin:auto;border-top:1px solid #e6e6e6;padding:1.5rem 1.25rem;color:#666;font-size:.85rem}.muted{color:#666}.post{border-bottom:1px solid #e6e6e6;padding:1.5rem 0}.post h2 a{color:#292929}.post h2 a:hover{color:#a32630}.eyebrow{font-size:.75rem;letter-spacing:.12em;color:#a32630;font-weight:700}.empty{border-block:1px solid #e6e6e6;padding:1.6rem 0;margin:2.5rem 0}.lead{font-size:1.1rem;color:#555;margin-bottom:2rem}time{font-size:.85rem;color:#666}@media(max-width:600px){main{padding-top:2rem}nav{gap:.8rem}}
</style>
